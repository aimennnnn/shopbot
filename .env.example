# ---- Agent API (api/) ----
# Copy to api/.env for local runs. On Render, add these under Environment.
# Never commit real values.
ANTHROPIC_API_KEY=your-claude-api-key
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
ADMIN_PASSWORD=choose-a-password-for-the-dashboard
MODEL=claude-haiku-5-5
SHOP_NAME=Dastkari

# ---- Website (web/) ----
# Copy to web/.env.local for local runs. On Vercel, add under Environment Variables.
VITE_API_URL=https://shopbot-api-vnny.onrender.com
